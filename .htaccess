Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule (^|/)\.(?!well-known/) - [F,L]
    RewriteRule ^(?:app|bin|database|docs|tests)(?:/|$) - [F,L,NC]
</IfModule>

<FilesMatch "^(?:config(?:-example)?\.php|README(?:\.md)?|.*\.(?:sql|log|ini|env|yml|yaml))$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always unset X-Powered-By
</IfModule>
